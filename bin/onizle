#!/bin/zsh
# Siteyi yerelde derler ve http://127.0.0.1:4000 adresinde sunar.
# Jekyll bir kez `bin/kur` ile vendor/gems içine kurulur (depoya girmez).
set -e
cd "${0:A:h}/.."
[[ -x vendor/gems/bin/jekyll ]] || { print -u2 "Jekyll kurulu değil: önce bin/kur"; exit 1; }
GEM_HOME=$PWD/vendor/gems exec vendor/gems/bin/jekyll serve --host 127.0.0.1 --port 4000 "$@"
